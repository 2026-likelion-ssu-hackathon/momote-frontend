# Team's Wellness Mate backend (separate repo, deployed on Railway).
# Swagger UI:   https://wellness-mate-backend-production.up.railway.app/swagger-ui.html
# OpenAPI JSON: https://wellness-mate-backend-production.up.railway.app/v3/api-docs
VITE_API_BASE_URL=https://wellness-mate-backend-production.up.railway.app

# Which chat room this build talks to, and which of its two participants it acts as. The API
# authenticates with a bare `X-User-Id` header and there is no signup or login, so identity is
# configuration — these have to be provisioned by the backend team and pasted in here.
#
# Leave them blank and the app runs its self-contained demo instead (local messages, canned replies,
# keyword-based mood) so the build stays presentable without a room.
VITE_CHAT_ROOM_ID=
VITE_USER_ID=

# For demoing the couple chat, override these per device with a query string — one build serves both
# sides, and the values persist in localStorage so a reload keeps that device signed in as whoever
# it was. Without this, both phones would be the same user and every message would look like "mine"
# on both of them.
#
#   phone A:  https://momote-frontend.vercel.app/?roomId=1&userId=1
#   phone B:  https://momote-frontend.vercel.app/?roomId=1&userId=2
